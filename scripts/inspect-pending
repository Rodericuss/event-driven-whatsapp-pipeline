#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
find "$ROOT/anuncios/pendentes" -mindepth 1 -maxdepth 1 -type d -print0 |
  sort -z |
  while IFS= read -r -d '' package; do
    python3 - "$package" <<'PY'
import json
import pathlib
import sys

package = pathlib.Path(sys.argv[1])
metadata = json.loads((package / "metadata.json").read_text())
status = json.loads((package / "status.json").read_text())
validation_path = package / "validacao.json"
validation = json.loads(validation_path.read_text()) if validation_path.exists() else None
print(json.dumps({
    "import_id": metadata["import_id"],
    "status": status["status"],
    "message_ids": metadata["message_ids"],
    "media_count": metadata["media_count"],
    "validated": status.get("validated", False),
    "validation_errors": (validation or {}).get("errors", []),
    "path": str(package),
}, ensure_ascii=False))
PY
  done
