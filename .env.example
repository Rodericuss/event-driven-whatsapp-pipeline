# Safe defaults: copy to .env and fill only on the machine that runs the importer.
DRY_RUN=true

# Optional path to an ignored local JSON file. The default is
# config/settings.local.json.
IMPORTER_SETTINGS_PATH=config/settings.local.json

# WhatsApp/OpenClaw allowlists. Never commit real phone numbers or JIDs.
OPENCLAW_PERSONAL_CHAT_ID=
OPENCLAW_ALLOWED_CHAT_IDS=
OPENCLAW_CONFIG_PATH=
OPENCLAW_MEDIA_ROOT=
SOURCE_GROUP_ENABLED=false
SOURCE_GROUP_SHADOW_MODE=true
SOURCE_GROUP_NAME=
SOURCE_GROUP_JID=
APPROVAL_CHAT_ID=
GROUP_PUBLICATION_ENABLED=false
GROUP_PUBLICATION_CHANNEL=whatsapp
PUBLICATION_GROUP_NAME=
PUBLICATION_GROUP_JID=
PERSONAL_PUBLICATION_ENABLED=false
PERSONAL_PUBLICATION_CHANNEL=whatsapp

# Terms removed from generated descriptions, separated by commas.
REDACTED_TERMS=

# Local extraction model.
OLLAMA_PROVIDER=ollama
OLLAMA_ENDPOINT=http://127.0.0.1:11434
OLLAMA_EXTRACTION_MODEL=qwen3-agent
OLLAMA_TIMEOUT_SECONDS=120

# Marketplace integration stays disabled until explicitly configured.
MARKETPLACE_ENABLED=false
MARKETPLACE_INTERNAL_URL=http://127.0.0.1:4000
MARKETPLACE_API_PATH=/api/internal/imported-products
MARKETPLACE_DRY_RUN_ONLY=true
MARKETPLACE_VISIBLE=false
MARKETPLACE_INTERNAL_API_TOKEN=
MARKETPLACE_FLY_APP=
MARKETPLACE_TOKEN_FILE=.marketplace-token
